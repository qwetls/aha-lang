{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "AHA!",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#types"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.aha",
                    "match": "//.*$"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.aha",
                    "match": "\\b(if|else|while|for|in|return|break|continue)\\b"
                },
                {
                    "name": "keyword.declaration.aha",
                    "match": "\\b(let|fn|struct)\\b"
                },
                {
                    "name": "constant.language.boolean.aha",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.aha",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.aha",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.aha",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.aha",
                    "match": "(\\+|\\-|\\*|\\/|==|!=|<=|>=|<|>|=|!)"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.aha",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                },
                {
                    "name": "support.function.builtin.aha",
                    "match": "\\b(print|print_str|abs|min|max)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "entity.name.type.aha",
                    "match": "\\b(int|bool|string)\\b"
                }
            ]
        }
    },
    "scopeName": "source.aha"
}