// todo_api.aha — Complete REST API: GET (list + single) and POST (create)
// Tutorial: https://aha-lang.dev/en/rest-api
//
// Test:
//   curl -X POST localhost:3000/api/todos -H 'Content-Type: application/json' -d '{"title":"Learn AHA!"}'
//   curl localhost:3000/api/todos
//   curl localhost:3000/api/todos/1

let server = http_listen(3000)
print_str("Todo API on http://localhost:3000")

let ids = list_new()
let titles = list_new_string()
let dones = list_new()
let next_id = 1

while 1 {
    let client = http_accept(server)
    let request = http_recv(client)
    let method = http_request_method(request)
    let path = http_request_path(request)

    // POST /api/todos — create
    if method == "POST" && path == "/api/todos" {
        let body = http_request_body(request)
        let data = json_parse(body)
        let title = json_get(data, "title")
        list_push(ids, next_id)
        list_push(titles, title)
        list_push(dones, 0)
        next_id = next_id + 1
        let resp = http_response(201, "{\"status\": \"created\"}")
        http_send(client, resp)
    }

    // GET /api/todos — list all
    if method == "GET" && path == "/api/todos" {
        let out = "{\"todos\": ["
        let n = list_len(ids)
        let i = 0
        while i < n {
            if i > 0 {
                out = out + ", "
            }
            out = out + "{\"id\": " + int_to_string(list_get(ids, i)) + ", \"title\": \"" + list_get(titles, i) + "\", \"done\": " + int_to_string(list_get(dones, i)) + "}"
            i = i + 1
        }
        out = out + "]}"
        let resp = http_response(200, out)
        http_send(client, resp)
    }

    // GET /api/todos/:id — one todo
    if method == "GET" && str_contains(path, "/api/todos/") {
        let parts = str_split(path, "/")
        let id_str = str_split_get(parts, 3)
        let want = str_to_int(id_str)
        str_split_free(parts)

        let found = 0
        let n = list_len(ids)
        let i = 0
        while i < n {
            if list_get(ids, i) == want {
                let body = "{\"id\": " + int_to_string(want) + ", \"title\": \"" + list_get(titles, i) + "\", \"done\": " + int_to_string(list_get(dones, i)) + "}"
                let resp = http_response(200, body)
                http_send(client, resp)
                found = 1
            }
            i = i + 1
        }
        if found == 0 {
            let resp = http_response(404, "{\"error\": \"not found\"}")
            http_send(client, resp)
        }
    }

    close_fd(client)
}
